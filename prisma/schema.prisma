// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Investigation {
  id          String   @id @default(cuid())
  status      InvestigationStatus @default(INITIALIZING)
  progress    Int      @default(0)
  currentStep String?
  currentPhase String  @default("ENRICHMENT")
  inputData   Json?
  finalReport Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  maxGeneration Int    @default(3)
  minConfidence Float  @default(0.7)
  graphData   Json?
  
  // Relations
  indicators  Indicator[]
  results     Result[]
  logs        InvestigationLog[]
  creditTransaction CreditTransaction?
  caseId      String?
  case        Case?      @relation(fields: [caseId], references: [id], onDelete: SetNull)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([status])
  @@index([userId])
  @@map("investigations")
}

model Case {
  id            String   @id @default(cuid())
  name          String
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  investigations Investigation[]
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cases")
}

model Indicator {
  id              String        @id @default(cuid())
  investigationId String
  type            IndicatorType
  value           String
  source          String? // buster, mosint, maigret, phoneinfoga, spiderfoot
  confidence      Float         @default(0.5)
  verified        Boolean       @default(false)
  status          String?       // ex: valid, invalid, risky (pour wau)
  processed       Boolean       @default(false) // Ajout pour le suivi du traitement
  generation      Int           @default(0)
  createdAt       DateTime      @default(now())

  investigation  Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  results       Result[]

  @@index([investigationId])
  @@index([processed, confidence, generation])
  @@unique([investigationId, type, value])
  @@map("indicators")
}

model Result {
  id             String     @id @default(cuid())
  investigationId String
  indicatorId    String?
  toolSource     String     // buster, mosint, maigret, phoneinfoga, spiderfoot
  data           Json
  score          Float      @default(0.0)
  createdAt      DateTime   @default(now())
  
  investigation  Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  indicator      Indicator?     @relation(fields: [indicatorId], references: [id], onDelete: SetNull)
  
  @@index([investigationId])
  @@index([toolSource])
  @@map("results")
}

model InvestigationLog {
  id             String     @id @default(cuid())
  investigationId String
  step           String
  message        String
  level          LogLevel    @default(INFO)
  timestamp      DateTime   @default(now())
  
  investigation  Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  userId         String?       // Optional, as some logs might be system-level
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([investigationId])
  @@index([userId])
  @@map("investigation_logs")
}

enum InvestigationStatus {
  INITIALIZING
  ENRICHING
  SCANNING
  CONSOLIDATING
  COMPLETED
  FAILED
  CANCELLED
  WARNING
  ERROR
  DEBUG
}

enum IndicatorType {
  NAME
  EMAIL
  USERNAME
  PHONE
  IP
  DOMAIN
  URL
  LOCATION
  COUNTRY
  ORGANIZATION
}

enum LogLevel {
  INFO
  WARNING
  ERROR
  DEBUG
}

// ==============================================================================
// ===                              USER & AUTH                             ===
// ==============================================================================

enum TransactionType {
  INITIAL_GRANT
  INVESTIGATION_COST
  PURCHASE
}

model CreditTransaction {
  id              String          @id @default(cuid())
  amount          Int
  type            TransactionType
  createdAt       DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  investigation   Investigation?  @relation(fields: [investigationId], references: [id], onDelete: SetNull)
  investigationId String?         @unique

  @@index([userId])
  @@map("credit_transactions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  credits       Int?      @default(5)
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  investigations Investigation[]
  cases         Case[]
  notifications Notification[]
  logs          InvestigationLog[]
  creditTransactions CreditTransaction[]
  templates     InvestigationTemplate[]
  subscription  Subscription?

  @@map("users")
}

enum Plan {
  DECOUVERTE
  ENQUETEUR
  STRATEGE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])
  plan               Plan               @default(DECOUVERTE)
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?
  stripeSubscriptionId String?            @unique
  stripeCustomerId     String?            @unique
  stripePriceId        String?
  stripeCurrentPeriodEnd DateTime?

  @@map("subscriptions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum Role {
  USER
  ADMIN
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

model InvestigationTemplate {
  id        String   @id @default(cuid())
  name      String
  inputData Json
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("investigation_templates")
}