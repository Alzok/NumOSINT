{
  "name": "numosint-tests",
  "version": "1.0.0",
  "description": "Tests for NumOSINT application",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/"],
    "testMatch": ["**/__tests__/**/*.(js|ts)", "**/*.(test|spec).(js|ts)"],
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest"
    }
  }
} 