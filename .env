# PostgreSQL Database Configuration
POSTGRES_DB=numosint
POSTGRES_USER=numosint
POSTGRES_PASSWORD=numosint_password

# Database connection URLs
# Pour développement local (quand vous ne vous servez pas de Docker)
DATABASE_URL_LOCAL=postgresql://numosint:numosint_password@localhost:5435/numosint

# Pour Docker (communication inter-conteneurs)
DATABASE_URL=postgresql://numosint:numosint_password@postgres:5432/numosint

# Redis Configuration
# Pour Docker (communication inter-conteneurs)  
REDIS_URL=redis://redis:6379

# Pour développement local (quand vous ne vous servez pas de Docker)
REDIS_URL_LOCAL=redis://localhost:6380

# External API Keys
# Get your API key from https://www.peopledatalabs.com/
PDL_API_KEY=49252bcc25a40bfccbe4b3906a310be25e1a63f9f0d3b9fa72780dce302ba0b5

# Application Configuration
NODE_ENV=production
PORT=5001
LOG_LEVEL=info

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5001

# Service URLs (pour communication inter-conteneurs Docker)
MAIGRET_SERVICE_URL=http://maigret-service:5002
BUSTER_SERVICE_URL=http://buster-service:5003
MOSINT_SERVICE_URL=http://mosint-service:5004
PHONEINFOGA_SERVICE_URL=http://phoneinfoga-service:5005
ASN_SERVICE_URL=http://asn-service:5008
WAU_SERVICE_URL=http://wau-service:8080
WAYBULK_SERVICE_URL=http://waybulk-service:5004
SPIDERFOOT_SERVICE_URL=http://spiderfoot-service:5006